# LoanMitra AI - Environment Variables Configuration

# Google Gemini AI API Key (Used strictly in serverless backend: api/assistant.js, api/documents/analyze.js)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Project Configuration
# Obtain from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Frontend Client Public Variables (Vite prefixed)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Optional: Set to 'demo' to run in full local interactive demo mode without live DB connection
# VITE_DEMO_MODE=true
